{
  "manifest_version": 3,
  "name": "Tab Junkie",
  "description": "Unified bookmark and tab manager",
  "version": "1.8.0",
  "permissions": ["tabs", "tabGroups", "storage", "sidePanel", "search"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+J"
      },
      "description": "Open quick search popup"
    },
    "_execute_side_panel": {
      "description": "Open side panel"
    },
    "open-junkie-window": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      },
      "description": "Open Tab Junkie window"
    },
    "group-jump": {
      "suggested_key": {
        "default": "Alt+K"
      },
      "description": "Jump to group"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
